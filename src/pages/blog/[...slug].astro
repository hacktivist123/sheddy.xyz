---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { ReadingProgress } from "../../components/ReadingProgress";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const ogImagePath = `/og/blog/${post.id.split("/").map(encodeURIComponent).join("/")}.png`;
const minutesRead = remarkPluginFrontmatter.minutesRead;

const all = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

function formatDate(date: Date): string {
	return date.toLocaleDateString("en-GB", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
}
---

<Layout
	title={`${post.data.title} - Shedrack Akintayo`}
	description={post.data.summary}
	ogImage={ogImagePath}
	ogType="article"
>
	<ReadingProgress client:load />

	<article class="mx-auto px-4 py-16 sm:py-24" style="max-width: var(--w-wide)">
		<header class="mx-auto" style="max-width: var(--w-prose)">
			<p class="meta">
				<a
					href="/blog"
					class="transition-colors duration-[160ms] hover:text-foreground"
					style="transition-timing-function: var(--ease-ui)">Writing</a
				>
			</p>

			<h1 class="mt-4 font-heading">{post.data.title}</h1>

			{
				post.data.summary && (
					<p class="mt-6 text-[length:var(--step-1)] leading-relaxed text-muted-foreground">
						{post.data.summary}
					</p>
				)
			}

			<div
				class="rule mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 pt-4"
			>
				<time class="numeral" datetime={post.data.date.toISOString()}>
					{formatDate(post.data.date)}
				</time>
				{minutesRead && <span class="numeral opacity-40" aria-hidden="true">/</span>}
				{minutesRead && <span class="numeral">{minutesRead}</span>}

				{
					post.data.tags && post.data.tags.length > 0 && (
						<span class="ml-auto flex flex-wrap gap-x-3 gap-y-1">
							{post.data.tags.map((tag: string) => (
								<a
									href={`/tags/${tag}`}
									class="numeral transition-colors duration-[160ms] hover:text-foreground"
									style="transition-timing-function: var(--ease-ui)"
								>
									#{tag}
								</a>
							))}
						</span>
					)
				}
			</div>
		</header>

		<div
			class="prose prose-neutral dark:prose-invert mx-auto mt-14 prose-headings:font-heading prose-headings:font-semibold prose-headings:tracking-[-0.02em] prose-p:leading-[1.75] prose-li:leading-[1.75] prose-a:text-foreground prose-a:decoration-[color:var(--rule-strong)] prose-a:underline-offset-[3px] prose-a:transition-colors hover:prose-a:decoration-current prose-blockquote:border-l-[color:var(--rule-strong)] prose-blockquote:font-heading prose-blockquote:not-italic prose-blockquote:text-foreground prose-code:text-[0.9em] prose-pre:rounded-xl prose-pre:border prose-pre:border-[color:var(--rule)] prose-img:rounded-lg prose-img:border prose-img:border-[color:var(--rule)]"
			style="max-width: var(--w-prose)"
		>
			<Content />
		</div>

		<footer class="mx-auto mt-20" style="max-width: var(--w-prose)">
			<div class="rule pt-6">
				<p class="meta">Continue</p>
				<div class="mt-5 grid gap-8 sm:grid-cols-2">
					{
						older && (
							<a href={`/blog/${older.id}`} class="group block">
								<span class="numeral">Older</span>
								<p class="mt-2 font-heading text-foreground">
									<span class="link-draw">{older.data.title}</span>
								</p>
							</a>
						)
					}
					{
						newer && (
							<a
								href={`/blog/${newer.id}`}
								class="group block sm:col-start-2 sm:text-right"
							>
								<span class="numeral">Newer</span>
								<p class="mt-2 font-heading text-foreground">
									<span class="link-draw">{newer.data.title}</span>
								</p>
							</a>
						)
					}
				</div>
			</div>
		</footer>
	</article>
</Layout>
