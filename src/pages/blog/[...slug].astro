---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

import { ReadingProgress } from '../../components/ReadingProgress';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
}

function getReadingTime(content: string): string {
  const wordsPerMinute = 200;
  const words = content.split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}
---

<Layout title={`${post.data.title} - Shedrack Akintayo`} description={post.data.summary}>
  <ReadingProgress client:load />
  <article class="container mx-auto max-w-5xl px-4 py-16">
    <header class="py-12">
      <time class="text-sm font-medium tracking-wide text-muted-foreground">
        {formatDate(post.data.date)}
      </time>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        {post.data.title}
      </h1>
      {post.data.summary && (
        <p class="mt-5 max-w-[70ch] text-xl leading-relaxed text-muted-foreground">
          {post.data.summary}
        </p>
      )}
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <a 
              href={`/tags/${tag}`}
              class="rounded-md bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground transition-colors hover:bg-secondary/80"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-neutral dark:prose-invert prose-lg max-w-[80ch] prose-headings:font-heading prose-headings:font-semibold prose-headings:tracking-[-0.02em] prose-p:text-[1.08rem] prose-p:leading-8 prose-li:leading-8 prose-a:text-primary prose-a:transition-colors hover:prose-a:text-primary/80 prose-blockquote:border-l-primary/35 prose-blockquote:text-foreground prose-code:text-[0.9em] prose-pre:rounded-2xl prose-pre:border prose-pre:border-border prose-img:rounded-xl prose-img:border prose-img:border-border prose-img:shadow-sm">
      <Content />
    </div>

    <footer class="mt-16 border-t border-border pt-8">
      <a 
        href="/blog" 
        class="text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        ← Back to all posts
      </a>
    </footer>
  </article>
</Layout>
