---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import Layout from "../../layouts/Layout.astro";

const posts: CollectionEntry<"blog">[] = await getCollection(
	"blog",
	({ data }) => !data.draft,
);
const sortedPosts = posts.sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Blog - Shedrack Akintayo">
  <div class="container mx-auto max-w-4xl px-4 py-16">
    <section class="py-12">
      <h1 class="text-5xl font-semibold tracking-tight sm:text-7xl"><span class="text-primary">/</span>Blog</h1>
      <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-muted-foreground">
        Thoughts on DevOps, cloud architecture, and technical writing.
      </p>
    </section>

    <section class="py-8">
      <PostList posts={sortedPosts} />
    </section>
  </div>
</Layout>
