---
import type { SimpleIcon } from "simple-icons";
import {
	siApple,
	siClaude,
	siImessage,
	siLenovo,
	siNordvpn,
	siSignal,
	siTailscale,
	siZedindustries,
	siZsh,
} from "simple-icons";
import Layout from "../layouts/Layout.astro";

type Logo =
	| Pick<SimpleIcon, "title" | "path" | "hex">
	| { title: string; mark: string; hex: string };

type UsesItem = {
	name: string;
	detail: string;
	logo: Logo;
	invertInDark?: boolean;
};

type UsesSection = {
	title: string;
	description: string;
	items: UsesItem[];
};

const openAI = {
	title: "OpenAI",
	hex: "10A37F",
	path: "M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z",
};
const nano = { title: "GNU nano", mark: "^X", hex: "2C7FB8" };
const cmux = { title: "cmux", mark: "cμ", hex: "6556D8" };
const ohMyPosh = { title: "Oh My Posh", mark: ">_", hex: "E84A72" };

const sections: UsesSection[] = [
	{
		title: "Models",
		description:
			"The model lineup I reach for to think, plan, advise, and move quickly.",
		items: [
			{ name: "GPT-5.6 Sol", detail: "Default model · xhigh", logo: openAI },
			{
				name: "Claude Fable 5",
				detail: "Advisor & plan · high",
				logo: siClaude,
				invertInDark: true,
			},
			{ name: "GPT-5.6 Luna", detail: "SMOL (fast) · high", logo: openAI },
		],
	},
	{
		title: "Editor",
		description:
			"A fast graphical editor, plus the editor that is always there.",
		items: [
			{ name: "Zed", detail: "Primary editor", logo: siZedindustries },
			{ name: "nano", detail: "Terminal editor", logo: nano },
		],
	},
	{
		title: "Terminal",
		description: "A small, dependable shell setup built for long sessions.",
		items: [
			{ name: "cmux", detail: "Terminal workspace", logo: cmux },
			{ name: "Oh My Posh", detail: "Prompt theme engine", logo: ohMyPosh },
			{ name: "zsh", detail: "Interactive shell", logo: siZsh },
		],
	},
	{
		title: "AI assistants",
		description:
			"Personal assistants that meet me in the messaging apps I already use.",
		items: [
			{
				name: "Poke",
				detail: "via iMessage",
				logo: siImessage,
				invertInDark: false,
			},
			{ name: "Hermes", detail: "via Signal · GLM 5.2", logo: siSignal },
		],
	},
	{
		title: "Machines",
		description: "Two portable Macs for daily work and one quiet Linux server.",
		items: [
			{
				name: "MacBook Air M5",
				detail: "24 GB memory · 1 TB storage",
				logo: siApple,
				invertInDark: true,
			},
			{
				name: "MacBook Pro M2",
				detail: "16 GB memory · 500 GB storage",
				logo: siApple,
				invertInDark: true,
			},
			{
				name: "Lenovo X13 Gen 2",
				detail: "Intel Core i5 · 256 GB · Ubuntu Server",
				logo: siLenovo,
			},
		],
	},
	{
		title: "VPN",
		description:
			"Private browsing on public networks and a mesh between every machine.",
		items: [
			{ name: "NordVPN", detail: "Public network privacy", logo: siNordvpn },
			{
				name: "Tailscale",
				detail: "Private device mesh",
				logo: siTailscale,
				invertInDark: true,
			},
		],
	},
];

const itemCount = sections.reduce(
	(total, section) => total + section.items.length,
	0,
);
---

<Layout
	title="Uses - Shedrack Akintayo"
	description="The models, editors, terminal tools, assistants, machines, and VPNs Shedrack Akintayo uses."
>
	<div class="container mx-auto max-w-4xl px-4 py-12 sm:py-20">
		<header class="border-b border-border pb-12 sm:pb-16">
			<h1 class="text-5xl font-semibold tracking-tight sm:text-7xl">
				<span class="text-primary">/</span>Uses
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
				The hardware, software, and AI systems that make up my everyday working environment.
			</p>
			<div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-muted-foreground">
				<p><span class="font-medium text-foreground">{sections.length}</span> categories</p>
				<p><span class="font-medium text-foreground">{itemCount}</span> daily tools</p>
				<p><span class="font-medium text-foreground">July 2026</span> edition</p>
			</div>
		</header>

		<div>
			{
				sections.map((section, sectionIndex) => (
					<section class="grid gap-6 border-b border-border py-10 last:border-b-0 sm:py-14 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10">
						<header>
							<p class="mb-2 text-xs font-medium tabular-nums text-primary">
								{String(sectionIndex + 1).padStart(2, "0")}
							</p>
							<h2 class="text-2xl font-semibold tracking-tight">{section.title}</h2>
							<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
								{section.description}
							</p>
						</header>

						<div class="grid gap-3 sm:grid-cols-2">
							{section.items.map((item) => (
								<article class="flex min-h-28 items-start gap-4 rounded-xl border border-border bg-card/60 p-4 shadow-[0_1px_0_rgba(0,0,0,0.02)]">
									<div
										class="uses-logo flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-border/70 bg-background shadow-sm"
										class:list={{ "uses-logo--invert": item.invertInDark }}
										style={`--logo-color: #${item.logo.hex}`}
										title={item.logo.title}
									>
										{"path" in item.logo ? (
											<svg
												aria-hidden="true"
												viewBox="0 0 24 24"
												class="h-5 w-5 fill-current"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path d={item.logo.path} />
											</svg>
										) : (
											<span aria-hidden="true" class="font-mono text-sm font-bold tracking-[-0.08em]">
												{item.logo.mark}
											</span>
										)}
									</div>
									<div class="min-w-0 pt-0.5">
										<h3 class="text-base font-semibold leading-snug tracking-tight text-foreground">
											{item.name}
										</h3>
										<p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
											{item.detail}
										</p>
									</div>
								</article>
							))}
						</div>
					</section>
				))
			}
		</div>

		<footer class="pt-6 text-sm text-muted-foreground">
			<p>This page changes as my setup does.</p>
		</footer>
	</div>
</Layout>

<style>
	.uses-logo {
		color: var(--logo-color);
	}

	:global(.dark) .uses-logo--invert {
		color: oklch(0.94 0.01 84);
	}
</style>
