---
import SectionHeading from "./SectionHeading.astro";

interface Props {
	index?: string;
}

const { index } = Astro.props;

const clients = [
	{ name: "Traefik Labs", url: "https://traefik.io" },
	{ name: "Isovalent", url: "https://isovalent.com" },
	{ name: "Cisco", url: "https://cisco.com" },
	{ name: "Wilco", url: "https://trywilco.com" },
	{ name: "Platform.sh", url: "https://platform.sh" },
	{ name: "Cloud Foundry", url: "https://cloudfoundry.org" },
	{ name: "LogRocket", url: "https://logrocket.com" },
	{ name: "Smashing Magazine", url: "https://smashingmagazine.com" },
	{ name: "Lumigo", url: "https://lumigo.io" },
	{ name: "Stackbit", url: "https://www.netlify.com/integrations/stackbit/" },
	{ name: "Evervault", url: "https://evervault.com" },
	{ name: "Keel", url: "https://keel.so" },
];
---

<section class="py-12 sm:py-16">
	<SectionHeading
		index={index}
		title="Employers & clients"
		dek="Places whose docs, content or developer programs I've built."
	/>

	<ul
		class="mt-8 grid grid-cols-2 gap-x-8 gap-y-3 sm:grid-cols-3 md:grid-cols-4"
		data-reveal
	>
		{
			clients.map((client) => (
				<li>
					<a
						href={client.url}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block text-sm text-muted-foreground transition-colors duration-[160ms] hover:text-foreground"
						style="transition-timing-function: var(--ease-ui)"
					>
						<span class="link-draw">{client.name}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
