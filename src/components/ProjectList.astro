---
const projects = [
	{
		title: "PullBase",
		description:
			"Gitops-based Configuration Management Platform built with Go.",
		href: "https://pullbase.io",
	},
	{
		title: "GoIgnore",
		description:
			"A lightweight CLI tool for generating .gitignore files instantly.",
		href: "https://github.com/hacktivist123/goignore",
	},
	{
		title: "Kpeek",
		description:
			"A comprehensive Kubernetes troubleshooting tool and cluster explorer.",
		href: "https://github.com/hacktivist123/kpeek",
	},
	{
		title: "DevOps Learning Plan",
		description:
			"A structured roadmap and resources for mastering DevOps and Cloud Native technologies.",
		href: "https://github.com/hacktivist123/DevOps-Learning-Plan",
	},
];
---

<section class="py-10 sm:py-16">
    <h2 class="mb-8 text-xl font-medium tracking-tight">Selected Projects</h2>
    <div class="grid gap-4 sm:grid-cols-2">
        {
            projects.map((project) => (
                <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative flex flex-col gap-3 rounded-2xl border border-border/40 bg-transparent p-6 transition-colors hover:border-border hover:bg-muted/20"
                >
                    <h3 class="flex items-center justify-between font-medium text-foreground">
                        <span>{project.title}</span>
                        <span class="text-muted-foreground/40 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground">↗</span>
                    </h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                        {project.description}
                    </p>
                </a>
            ))
        }
    </div>
</section>
