---
import { ModeToggle } from "./ModeToggle";

const primaryLinks = [
	{ href: "/", label: "Home", index: "00" },
	{ href: "/blog", label: "Writing", index: "01" },
	{ href: "/talks", label: "Talks", index: "02" },
	{ href: "/about", label: "About", index: "03" },
];

const secondaryLinks = [
	{ href: "/bookmarks", label: "Bookmarks" },
	{ href: "/tags", label: "Topics" },
	{ href: "/uses", label: "Uses" },
];

const externalLinks = [
	{ href: "https://github.com/hacktivist123", label: "GitHub" },
	{ href: "https://twitter.com/coder_blvck", label: "Twitter" },
	{ href: "https://linkedin.com/in/shedrackakintayo", label: "LinkedIn" },
	{ href: "/feed.xml", label: "RSS", external: false },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
	<div class="site-header__inner">
		<a
			href="/"
			aria-label="Shedrack Akintayo, home"
			aria-current={pathname === "/" ? "page" : undefined}
			class="site-header__wordmark"
		>
			<span class="sm:hidden">SA</span>
			<span class="hidden sm:inline">Shedrack Akintayo</span>
		</a>

		<nav class="site-header__fallback" aria-label="Primary navigation">
			{
				primaryLinks.slice(1).map((link) => (
					<a
						href={link.href}
						aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="site-header__actions">
			<ModeToggle client:load />
			<button
				type="button"
				class="menu-button"
				data-nav-open
				aria-controls="site-navigation"
				aria-expanded="false"
				aria-haspopup="dialog"
			>
				<span class="sr-only">Open navigation</span>
				<span class="menu-button__lines" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>
</header>

<dialog
	id="site-navigation"
	class="site-nav"
	data-site-nav
	aria-labelledby="site-navigation-title"
>
	<div class="site-nav__surface">
		<header class="site-nav__header">
			<a href="/" class="site-nav__wordmark">Shedrack Akintayo</a>
			<button
				type="button"
				class="site-nav__close"
				data-nav-close
				autofocus
			>
				<span class="sr-only">Close navigation</span>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 5l14 14M19 5 5 19"></path>
				</svg>
			</button>
		</header>

		<h2 id="site-navigation-title" class="sr-only">Site navigation</h2>

		<div class="site-nav__grid">
			<div class="site-nav__identity" aria-hidden="true">
				<p class="site-nav__edition">Field notes from Manchester</p>
				<p class="site-nav__identity-title">
					Technical writing,<br />cloud native systems,<br />and the tools between.
				</p>
			</div>

			<div class="site-nav__utility">
				<nav aria-label="Browse">
					<p class="site-nav__label">Browse</p>
					<ul>
						{
							secondaryLinks.map((link) => (
								<li>
									<a
										href={link.href}
										aria-current={isActive(link.href) ? "page" : undefined}
										data-astro-prefetch={
											link.href === "/bookmarks" ? "hover" : undefined
										}
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav aria-label="Elsewhere">
					<p class="site-nav__label">Elsewhere</p>
					<ul>
						{
							externalLinks.map((link) => (
								<li>
									<a
										href={link.href}
										target={link.external === false ? undefined : "_blank"}
										rel={
											link.external === false
												? undefined
												: "noopener noreferrer"
										}
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>

			<nav class="site-nav__primary" aria-label="Primary navigation">
				<p class="site-nav__label">Index</p>
				<ol>
					{
						primaryLinks.map((link) => (
							<li>
								<a
									href={link.href}
									aria-current={isActive(link.href) ? "page" : undefined}
								>
									<span class="site-nav__number">{link.index}</span>
									<span>{link.label}</span>
								</a>
							</li>
						))
					}
				</ol>
			</nav>
		</div>

		<footer class="site-nav__footer">
			<p>Manchester, UK</p>
			<div class="site-nav__theme">
				<span>Colour</span>
				<ModeToggle client:load />
			</div>
			<p class="site-nav__hint"><kbd>Esc</kbd> closes</p>
		</footer>
	</div>
</dialog>

<script is:inline>
	const setupSiteNavigation = () => {
		const dialog = document.querySelector('[data-site-nav]');
		const openButton = document.querySelector('[data-nav-open]');
		if (
			!(dialog instanceof HTMLDialogElement) ||
			!(openButton instanceof HTMLButtonElement) ||
			dialog.dataset.ready === 'true'
		) return;

		dialog.dataset.ready = 'true';
		const closeButton = dialog.querySelector('[data-nav-close]');
		let closePending = false;
		let closeFallback;

		const finishClose = () => {
			closePending = false;
			window.clearTimeout(closeFallback);
			if (dialog.open) dialog.close();
		};

		const openNavigation = () => {
			closePending = false;
			window.clearTimeout(closeFallback);
			if (!dialog.open) dialog.showModal();
			document.documentElement.classList.add('nav-open');
			openButton.setAttribute('aria-expanded', 'true');
			requestAnimationFrame(() => dialog.classList.add('is-open'));
		};

		const closeNavigation = () => {
			if (!dialog.open || closePending) return;
			closePending = true;
			dialog.classList.remove('is-open');
			document.documentElement.classList.remove('nav-open');
			openButton.setAttribute('aria-expanded', 'false');
			closeFallback = window.setTimeout(finishClose, 900);
		};

		openButton.addEventListener('click', openNavigation);
		closeButton?.addEventListener('click', closeNavigation);
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeNavigation();
		});
		dialog.addEventListener('transitionend', (event) => {
			if (
				closePending &&
				event.target === dialog &&
				(event.propertyName === 'clip-path' || event.propertyName === 'opacity')
			) finishClose();
		});
		dialog.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				dialog.classList.remove('is-open');
				document.documentElement.classList.remove('nav-open');
				openButton.setAttribute('aria-expanded', 'false');
				finishClose();
			});
		});
	};

	setupSiteNavigation();
	document.addEventListener('astro:page-load', setupSiteNavigation);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		border-bottom: 1px solid var(--rule);
		background: color-mix(in oklch, var(--background) 88%, transparent);
		backdrop-filter: blur(18px) saturate(125%);
	}

	.site-header__inner,
	.site-nav__header,
	.site-nav__grid,
	.site-nav__footer {
		width: min(100% - 2rem, var(--w-wide));
		margin-inline: auto;
	}

	.site-header__inner {
		display: flex;
		height: 4rem;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-header__wordmark,
	.site-nav__wordmark {
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1;
		white-space: nowrap;
	}

	.site-header__fallback,
	.site-header__actions {
		display: flex;
		align-items: center;
	}

	.site-header__fallback {
		gap: 1.5rem;
		font-size: 0.85rem;
		color: var(--muted-foreground);
	}

	.site-header__fallback a[aria-current="page"] {
		color: var(--foreground);
	}

	.site-header__actions {
		display: none;
		gap: 0.5rem;
	}

	:global(.js-reveal) .site-header__fallback {
		display: none;
	}

	:global(.js-reveal) .site-header__actions {
		display: flex;
	}

	.menu-button,
	.site-nav__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		background: transparent;
		color: currentColor;
		cursor: pointer;
		touch-action: manipulation;
		transition:
			transform var(--dur-fast) var(--ease-out),
			opacity var(--dur-fast) var(--ease-out);
	}

	.menu-button:active,
	.site-nav__close:active {
		transform: scale(0.97);
	}

	.menu-button {
		width: 3rem;
		height: 2.25rem;
		padding: 0.75rem 0.25rem;
	}

	.menu-button__lines {
		position: relative;
		display: block;
		width: 2.25rem;
		height: 0.625rem;
	}

	.menu-button__lines > span {
		position: absolute;
		left: 0;
		top: calc(50% - 0.5px);
		width: 100%;
		height: 1px;
		background: currentColor;
		transform-origin: center;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.menu-button__lines > span:first-child {
		transform: translateY(-0.25rem);
	}

	.menu-button__lines > span:last-child {
		transform: translateY(0.25rem);
	}

	.menu-button[aria-expanded="true"] .menu-button__lines > span:first-child {
		transform: rotate(45deg);
	}

	.menu-button[aria-expanded="true"] .menu-button__lines > span:last-child {
		transform: rotate(-45deg);
	}

	.site-nav {
		position: fixed;
		inset: 0;
		z-index: 100;
		width: 100%;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--nav-foreground);
		clip-path: inset(0 0 100% 0);
		transition: clip-path var(--dur-nav-close) var(--ease-nav)
			var(--delay-nav-close);
	}

	.site-nav::backdrop {
		background: transparent;
	}

	.site-nav.is-open {
		clip-path: inset(0);
		transition: clip-path var(--dur-nav) var(--ease-nav) 0ms;
	}

	.site-nav__surface {
		position: fixed;
		inset: 0;
	}

	.site-nav__surface {
		min-height: 100%;
		display: flex;
		flex-direction: column;
		overflow-y: auto;
		background: var(--nav-surface);
	}

	.site-nav__header {
		display: flex;
		min-height: 5rem;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--nav-rule);
	}

	.site-nav__close {
		width: 2.75rem;
		height: 2.75rem;
	}

	.site-nav__close svg {
		width: 1.4rem;
		height: 1.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
		stroke-linecap: square;
	}

	.site-nav__grid {
		display: grid;
		flex: 1;
		grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.68fr) minmax(18rem, 1fr);
		grid-template-areas: "identity utility primary";
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
		padding-block: clamp(3.5rem, 10vh, 7rem);
	}

	.site-nav__identity {
		grid-area: identity;
		align-self: stretch;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 18rem;
	}

	.site-nav__edition,
	.site-nav__label,
	.site-nav__footer {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.site-nav__edition,
	.site-nav__label,
	.site-nav__footer,
	.site-nav__utility a,
	.site-nav__number {
		color: var(--nav-muted);
	}

	.site-nav__identity-title {
		max-width: 20ch;
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 2vw, 2rem);
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.site-nav__utility {
		grid-area: utility;
		display: grid;
		gap: 2.5rem;
	}

	.site-nav__utility ul,
	.site-nav__primary ol {
		margin-top: 1rem;
	}

	.site-nav__utility a {
		display: inline-block;
		font-size: 0.95rem;
		line-height: 1.6;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.site-nav__utility a[aria-current="page"] {
		color: var(--nav-foreground);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.site-nav__primary {
		grid-area: primary;
	}

	.site-nav__primary li,
	.site-nav__utility nav,
	.site-nav__identity,
	.site-nav__footer > * {
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity var(--dur-nav-item-out) var(--ease-out),
			transform var(--dur-nav-item-out) var(--ease-out);
	}

	.site-nav.is-open .site-nav__primary li,
	.site-nav.is-open .site-nav__utility nav,
	.site-nav.is-open .site-nav__identity,
	.site-nav.is-open .site-nav__footer > * {
		opacity: 1;
		transform: none;
		transition:
			opacity var(--dur-nav-item) var(--ease-nav) var(--nav-item-delay, 0ms),
			transform var(--dur-nav-item) var(--ease-nav) var(--nav-item-delay, 0ms);
	}

	.site-nav.is-open .site-nav__primary li:nth-child(1) { --nav-item-delay: 0ms; }
	.site-nav.is-open .site-nav__primary li:nth-child(2) { --nav-item-delay: 30ms; }
	.site-nav.is-open .site-nav__primary li:nth-child(3) { --nav-item-delay: 60ms; }
	.site-nav.is-open .site-nav__primary li:nth-child(4) { --nav-item-delay: 90ms; }
	.site-nav.is-open .site-nav__utility nav:nth-child(1) { --nav-item-delay: 30ms; }
	.site-nav.is-open .site-nav__utility nav:nth-child(2) { --nav-item-delay: 60ms; }
	.site-nav.is-open .site-nav__identity { --nav-item-delay: 30ms; }
	.site-nav.is-open .site-nav__footer > * { --nav-item-delay: 60ms; }

	.site-nav__primary a {
		display: grid;
		grid-template-columns: 2rem 1fr;
		align-items: baseline;
		font-family: var(--font-heading);
		font-size: clamp(2.35rem, 4.2vw, 4.5rem);
		line-height: 1.03;
		letter-spacing: -0.035em;
		color: var(--nav-muted);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.site-nav__primary a[aria-current="page"] {
		color: var(--nav-foreground);
	}

	.site-nav__number {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
	}

	.site-nav__footer {
		display: grid;
		min-height: 4.5rem;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		border-top: 1px solid var(--nav-rule);
	}

	.site-nav__theme {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.site-nav__hint {
		justify-self: end;
	}

	.site-nav__hint kbd {
		font: inherit;
		color: var(--nav-foreground);
	}

	:global(.nav-open) {
		overflow: hidden;
	}

	@media (hover: hover) and (pointer: fine) {
		.menu-button:hover,
		.site-nav__close:hover {
			opacity: 0.55;
		}

		.site-nav__utility a:hover,
		.site-nav__primary a:hover {
			color: var(--nav-foreground);
		}
	}

	@media (max-width: 48rem) {
		.site-nav__header {
			min-height: 4.5rem;
		}

		.site-nav__grid {
			grid-template-columns: 1fr;
			grid-template-areas:
				"primary"
				"utility"
				"identity";
			gap: 3rem;
			padding-block: 2.5rem;
		}

		.site-nav__identity {
			min-height: auto;
			gap: 1rem;
			padding-top: 2rem;
			border-top: 1px solid var(--nav-rule);
		}

		.site-nav__utility {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}

		.site-nav__primary a {
			font-size: clamp(2.2rem, 12vw, 3.6rem);
		}

		.site-nav__footer {
			grid-template-columns: 1fr auto;
		}

		.site-nav__hint {
			display: none;
		}
	}

	@media (max-width: 24rem) {
		.site-header__inner,
		.site-nav__header,
		.site-nav__grid,
		.site-nav__footer {
			width: min(100% - 1.25rem, var(--w-wide));
		}

		.site-nav__primary a {
			grid-template-columns: 1.5rem 1fr;
			font-size: 2.15rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav {
			clip-path: none;
			opacity: 0;
			transition: opacity var(--dur-fast) var(--ease-out);
		}

		.site-nav.is-open {
			opacity: 1;
			transition: opacity var(--dur-fast) var(--ease-out);
		}

		.site-nav__primary li,
		.site-nav__utility nav,
		.site-nav__identity,
		.site-nav__footer > *,
		.site-nav.is-open .site-nav__primary li,
		.site-nav.is-open .site-nav__utility nav,
		.site-nav.is-open .site-nav__identity,
		.site-nav.is-open .site-nav__footer > * {
			opacity: 1;
			transform: none;
			transition: none;
		}

		.menu-button__lines > span,
		.menu-button[aria-expanded="true"] .menu-button__lines > span {
			transition: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.site-header {
			background: var(--background);
			backdrop-filter: none;
		}
	}

	@media (prefers-contrast: more) {
		.site-header,
		.site-nav__header,
		.site-nav__footer,
		.site-nav__identity {
			border-color: currentColor;
		}
	}
</style>
