---
interface Props {
	index?: string;
	title: string;
	dek?: string;
	href?: string;
	linkLabel?: string;
}

const { index, title, dek, href, linkLabel } = Astro.props;
---

<div class="rule rule-draw flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-4" data-reveal>
	<div class="flex items-baseline gap-4">
		{index && <span class="numeral pt-1 select-none" aria-hidden="true">{index}</span>}
		<div>
			<h2 class="font-heading">{title}</h2>
			{dek && (
				<p class="mt-1.5 max-w-[52ch] text-sm leading-relaxed text-muted-foreground">
					{dek}
				</p>
			)}
		</div>
	</div>

	{href && (
		<a
			href={href}
			class="group inline-flex shrink-0 items-baseline gap-1.5 text-sm text-muted-foreground transition-colors duration-[160ms] hover:text-foreground"
			style="transition-timing-function: var(--ease-ui)"
		>
			<span class="link-draw">{linkLabel ?? "See all"}</span>
			<span
				class="inline-block transition-transform duration-[220ms] group-hover:translate-x-1"
				style="transition-timing-function: var(--ease-ui)"
				aria-hidden="true">&rarr;</span
			>
		</a>
	)}
</div>
