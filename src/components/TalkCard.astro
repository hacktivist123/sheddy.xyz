---
import {
	kindLabel,
	posterUrl,
	runtimeLabel,
	type Talk,
	watchUrl,
} from "../data/talks";

interface Props {
	talk: Talk;
	/** Larger treatment for the lead item in a grid */
	lead?: boolean;
}

const { talk, lead = false } = Astro.props;

function formatDate(iso: string): string {
	return new Date(iso).toLocaleDateString("en-GB", {
		year: "numeric",
		month: "short",
	});
}
---

<a
	href={watchUrl(talk)}
	target="_blank"
	rel="noopener noreferrer"
	class="group flex flex-col gap-4"
>
	{/* Poster: fixed frame, image scales inside it. */}
	<div
		class="relative overflow-hidden rounded-lg bg-muted"
		style="aspect-ratio: 16 / 9"
	>
		<img
			src={posterUrl(talk)}
			alt=""
			loading="lazy"
			decoding="async"
			width="480"
			height="360"
			class="h-full w-full object-cover transition-[transform,filter] duration-[260ms] grayscale-[0.25] group-hover:scale-[1.03] group-hover:grayscale-0"
			style="transition-timing-function: var(--ease-entrance)"
		/>

		{/* Play badge: springs up on hover. */}
		<span
			class="absolute inset-0 flex items-center justify-center bg-background/0 transition-colors duration-[220ms] group-hover:bg-background/10"
			style="transition-timing-function: var(--ease-ui)"
			aria-hidden="true"
		>
			<span
				class="flex h-11 w-11 translate-y-1 items-center justify-center rounded-full bg-background/85 opacity-0 shadow-sm backdrop-blur transition-[opacity,transform] duration-[220ms] group-hover:translate-y-0 group-hover:opacity-100"
				style="transition-timing-function: var(--ease-entrance)"
			>
				<svg
					width="14"
					height="16"
					viewBox="0 0 14 16"
					fill="currentColor"
					class="ml-0.5 text-foreground"
					aria-hidden="true"
				>
					<path d="M0 1.2v13.6a1 1 0 0 0 1.53.85l10.9-6.8a1 1 0 0 0 0-1.7L1.53.35A1 1 0 0 0 0 1.2Z"></path>
				</svg>
			</span>
		</span>

		<span
			class="absolute right-2 bottom-2 rounded bg-background/85 px-1.5 py-0.5 font-mono text-[0.65rem] tabular-nums text-foreground backdrop-blur"
		>
			{runtimeLabel(talk)}
		</span>
	</div>

	<div>
		<div class="meta flex flex-wrap items-center gap-x-2 gap-y-1">
			<span>{kindLabel[talk.kind]}</span>
			<span aria-hidden="true" class="opacity-40">/</span>
			<span>{formatDate(talk.date)}</span>
		</div>

		<h3
			class:list={[
				"mt-2 font-heading text-foreground",
				lead && "text-[length:var(--step-2)]",
			]}
		>
			<span class="link-draw">{talk.title}</span>
		</h3>

		<p class="mt-1 text-sm text-muted-foreground">{talk.event}</p>

		<p class="mt-2.5 max-w-[52ch] text-[0.95rem] leading-relaxed text-muted-foreground">
			{talk.dek}
		</p>
	</div>
</a>
