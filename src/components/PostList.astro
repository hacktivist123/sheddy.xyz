---
interface Post {
	id: string;
	data: {
		title: string;
		date: Date;
		summary?: string;
	};
}

interface Props {
	posts: Post[];
	limit?: number;
	reveal?: boolean;
}

const { posts, limit, reveal = true } = Astro.props;
const displayPosts = limit ? posts.slice(0, limit) : posts;

function formatDate(date: Date): string {
	return date.toLocaleDateString("en-GB", {
		year: "numeric",
		month: "short",
		day: "2-digit",
	});
}
---

<ul class="flex flex-col">
	{
		displayPosts.map((post, i) => (
			<li
				class="rule first:border-t-0"
				data-reveal={reveal ? "" : undefined}
				style={reveal ? `--reveal-delay: ${Math.min(i, 8) * 40}ms` : undefined}
			>
				<a
					href={`/blog/${post.id}`}
					class="row group grid gap-x-8 gap-y-1.5 py-6 sm:grid-cols-[7.5rem_1fr]"
				>
					<time
						datetime={post.data.date.toISOString()}
						class="numeral pt-1.5 transition-[color,transform] duration-[220ms] group-hover:translate-x-0.5 group-hover:text-foreground"
						style="transition-timing-function: var(--ease-ui)"
					>
						{formatDate(post.data.date)}
					</time>

					<div class="max-w-[58ch]">
						<h3 class="font-heading text-foreground">
							<span class="link-draw">{post.data.title}</span>
						</h3>
						{post.data.summary && (
							<p class="mt-2 text-[0.95rem] leading-relaxed text-muted-foreground">
								{post.data.summary}
							</p>
						)}
					</div>
				</a>
			</li>
		))
	}
</ul>
